def train_model(model_name):
    print(f"\n🚀 Training {model_name.upper()} for Soil Fertility Prediction...")
    
    # Load data
    df = load_and_preprocess_soil_data()
    if df is None:
        return
    
    # Define CSV features
    csv_features = ['OC', 'pH_H2O', 'P', 'K', 'N', 'EC', 'CaCO3']
    csv_features = [f for f in csv_features if f in df.columns]
    
    print(f"📊 Using {len(csv_features)} soil parameters: {csv_features}")
    
    # Split data
    train_size = int(0.8 * len(df))
    df_train = df.sample(n=train_size, random_state=42)
    df_val = df.drop(df_train.index)
    
    print(f"📈 Training samples: {len(df_train)}")
    print(f"📊 Validation samples: {len(df_val)}")
    
    # Build datasets
    train_ds, scaler, fertility_encoder, land_use_encoder = build_soil_dataset(
        df_train, csv_features, shuffle=True, augment=True
    )
    val_ds, _, _, _ = build_soil_dataset(
        df_val, csv_features, shuffle=False, augment=False
    )
    
    # Get model
    model = get_model(model_name, len(csv_features))
    
    print("📋 Model Summary:")
    model.summary()
    
    # Callbacks
    model_path = os.path.join(MODELS_DIR, f"soil_model_{model_name}")
    
    callbacks = [
        keras.callbacks.EarlyStopping(
            monitor='val_loss', patience=10, restore_best_weights=True, verbose=1
        ),
        keras.callbacks.ReduceLROnPlateau(
            monitor='val_loss', factor=0.5, patience=5, verbose=1
        ),
        keras.callbacks.ModelCheckpoint(
            model_path, save_best_only=True, monitor='val_loss', verbose=1
        )
    ]
    
    # Training
    print("🎯 Starting training...")
    history = model.fit(
        train_ds,
        validation_data=val_ds,
        epochs=EPOCHS,
        callbacks=callbacks,
        verbose=1
    )
    
    # Plot training history
    plot_training_history(history, model_name)
    
    # Save encoders and scaler
    import joblib
    joblib.dump(fertility_encoder, os.path.join(MODELS_DIR, f'fertility_encoder_{model_name}.pkl'))
    joblib.dump(land_use_encoder, os.path.join(MODELS_DIR, f'land_use_encoder_{model_name}.pkl'))
    joblib.dump(scaler, os.path.join(MODELS_DIR, f'feature_scaler_{model_name}.pkl'))
    joblib.dump(csv_features, os.path.join(MODELS_DIR, f'csv_features_{model_name}.pkl'))
    
    print(f"✅ Model and artifacts saved to: {model_path}")

def plot_training_history(history, model_name):
    """Plot training history for multi-task learning."""
    fig, axes = plt.subplots(2, 3, figsize=(18, 10))
    
    # Loss plots
    axes[0,0].plot(history.history['loss'], label='Train Total Loss')
    axes[0,0].plot(history.history['val_loss'], label='Val Total Loss')
    axes[0,0].set_title('Total Loss')
    axes[0,0].legend()
    
    axes[0,1].plot(history.history['fertility_reg_loss'], label='Train Reg Loss')
    axes[0,1].plot(history.history['val_fertility_reg_loss'], label='Val Reg Loss')
    axes[0,1].set_title('Fertility Regression Loss')
    axes[0,1].legend()
    
    axes[0,2].plot(history.history['fertility_cls_loss'], label='Train Cls Loss')
    axes[0,2].plot(history.history['val_fertility_cls_loss'], label='Val Cls Loss')
    axes[0,2].set_title('Fertility Classification Loss')
    axes[0,2].legend()
    
    # Metric plots
    axes[1,0].plot(history.history['fertility_reg_mae'], label='Train MAE')
    axes[1,0].plot(history.history['val_fertility_reg_mae'], label='Val MAE')
    axes[1,0].set_title('Fertility Score MAE')
    axes[1,0].legend()
    
    axes[1,1].plot(history.history['fertility_cls_accuracy'], label='Train Acc')
    axes[1,1].plot(history.history['val_fertility_cls_accuracy'], label='Val Acc')
    axes[1,1].set_title('Fertility Classification Accuracy')
    axes[1,1].legend()
    
    axes[1,2].plot(history.history['land_use_accuracy'], label='Train Acc')
    axes[1,2].plot(history.history['val_land_use_accuracy'], label='Val Acc')
    axes[1,2].set_title('Land Use Accuracy')
    axes[1,2].legend()
    
    plt.suptitle(f'Training History - {model_name.upper()}', fontsize=16)
    plt.tight_layout()
    plt.savefig(os.path.join(PROJECT_ROOT, f"soil_training_{model_name}.png"), dpi=150, bbox_inches='tight')
    plt.show()

