def load_and_preprocess_soil_data():
    """Load and preprocess soil data for multi-task learning."""
    if not os.path.exists(CLEAN_DATA_PATH):
        print(f"❌ Clean soil data not found at {CLEAN_DATA_PATH}")
        print("👉 Please run the exploration script first!")
        return None
    
    df = pd.read_csv(CLEAN_DATA_PATH)
    print(f"✅ Loaded {len(df)} soil samples")
    

    
    # Filter valid samples
    df['photo_exists'] = df['photo_path'].apply(lambda x: x is not None and os.path.exists(x))
    df = df[df['photo_exists']].copy()
    
    if len(df) == 0:
        print("❌ No valid samples with images found!")
        return None
    
    print(f"✅ {len(df)} samples with valid images")
    return df

def build_soil_dataset(df, csv_features, shuffle=True, augment=False):
    """Build tf.data.Dataset for multi-task soil fertility prediction."""
    
    # Encode targets
    fertility_encoder = LabelEncoder()
    land_use_encoder = LabelEncoder()
    
    df['fertility_encoded'] = fertility_encoder.fit_transform(df['Fertility_Class'])
    df['land_use_encoded'] = land_use_encoder.fit_transform(df['LU1_Desc'])
    
    # Scale CSV features
    scaler = StandardScaler()
    csv_data = scaler.fit_transform(df[csv_features].fillna(0).values)
    
    def load_and_preprocess_image(path):
        """Load and preprocess a single image."""
        img = tf.io.read_file(path)
        img = tf.image.decode_jpeg(img, channels=3)
        img = tf.image.resize(img, [IMG_SIZE, IMG_SIZE])
        img = tf.cast(img, tf.float32) / 255.0
        return img
    
    def process_sample(idx):
        """Process a single sample with image and CSV data."""
        row_idx = idx.numpy()
        img_path = df.iloc[row_idx]['photo_path']
        csv_features = csv_data[row_idx]
        
        # Load image
        img = load_and_preprocess_image(img_path)
        
        # Targets
        fertility_score = tf.cast(df.iloc[row_idx]['fertility_score_advanced'], tf.float32)
        fertility_class = tf.cast(df.iloc[row_idx]['fertility_encoded'], tf.int32)
        land_use = tf.cast(df.iloc[row_idx]['land_use_encoded'], tf.int32)
        
        return (img, csv_features), {
            'fertility_reg': fertility_score,
            'fertility_cls': fertility_class,
            'land_use': land_use
        }
    
    # Create dataset
    indices = tf.range(len(df))
    dataset = tf.data.Dataset.from_tensor_slices(indices)
    
    if shuffle:
        dataset = dataset.shuffle(len(df))
    
    dataset = dataset.map(
        lambda x: tf.py_function(process_sample, [x], 
                               [tf.float32, tf.float32, 
                                tf.float32, tf.int32, tf.int32]),
        num_parallel_calls=tf.data.AUTOTUNE
    )
    
    # Separate inputs and outputs
    def separate_inputs_outputs(img, csv, reg_target, cls_target, lu_target):
        return (img, csv), {
            'fertility_reg': reg_target,
            'fertility_cls': cls_target,
            'land_use': lu_target
        }
    
    dataset = dataset.map(separate_inputs_outputs, num_parallel_calls=tf.data.AUTOTUNE)
    
    if augment:
        def augment_image(img, csv, targets):
            img = tf.image.random_flip_left_right(img)
            img = tf.image.random_flip_up_down(img)
            img = tf.image.random_brightness(img, 0.2)
            return (img, csv), targets
        
        dataset = dataset.map(augment_image, num_parallel_calls=tf.data.AUTOTUNE)
    
    dataset = dataset.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)
    return dataset, scaler, fertility_encoder, land_use_encoder

# =============================================================================
# MODEL ARCHITECTURES - Multi-Task Learning
# =============================================================================

def get_model(model_name, num_csv_features):
    """Return compiled multi-task model based on name."""
    
    # Image input
    img_input = layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3), name='image_input')
    
    # CSV features input
    csv_input = layers.Input(shape=(num_csv_features,), name='csv_input')
    
    if model_name == "efficientnet":
        base = tf.keras.applications.EfficientNetB0(
            include_top=False, weights='imagenet', input_tensor=img_input
        )
    elif model_name == "resnet":
        base = tf.keras.applications.ResNet50V2(
            include_top=False, weights='imagenet', input_tensor=img_input
        )
    elif model_name == "vit":
        return build_vit_multitask_model(num_csv_features)
    else:
        raise ValueError("Unknown model")

    # Freeze base initially
    base.trainable = False
    
    # Image branch
    img_features = base.output
    img_features = layers.GlobalAveragePooling2D()(img_features)
    img_features = layers.BatchNormalization()(img_features)
    img_features = layers.Dropout(0.3)(img_features)
    
    # CSV branch
    csv_features = layers.Dense(128, activation='relu')(csv_input)
    csv_features = layers.BatchNormalization()(csv_features)
    csv_features = layers.Dropout(0.3)(csv_features)
    
    # Combined features
    combined = layers.Concatenate()([img_features, csv_features])
    combined = layers.Dense(256, activation='relu')(combined)
    combined = layers.BatchNormalization()(combined)
    combined = layers.Dropout(0.4)(combined)
    
    # Output heads
    # Regression head for fertility score
    fertility_reg = layers.Dense(128, activation='relu')(combined)
    fertility_reg_output = layers.Dense(1, activation='linear', name='fertility_reg')(fertility_reg)
    
    # Classification head for fertility class
    fertility_cls = layers.Dense(128, activation='relu')(combined)
    fertility_cls_output = layers.Dense(NUM_FERTILITY_CLASSES, activation='softmax', name='fertility_cls')(fertility_cls)
    
    # Classification head for land use
    land_use = layers.Dense(128, activation='relu')(combined)
    land_use_output = layers.Dense(10, activation='softmax', name='land_use')(land_use)  # Adjust based on your data
    
    model = keras.Model(inputs=[img_input, csv_input], 
                       outputs=[fertility_reg_output, fertility_cls_output, land_use_output])
    
    # Custom loss weights
    losses = {
        'fertility_reg': 'mse',
        'fertility_cls': 'sparse_categorical_crossentropy',
        'land_use': 'sparse_categorical_crossentropy'
    }
    
    loss_weights = {
        'fertility_reg': 0.4,
        'fertility_cls': 0.4,
        'land_use': 0.2
    }
    
    metrics = {
        'fertility_reg': ['mae', 'mse'],
        'fertility_cls': ['accuracy'],
        'land_use': ['accuracy']
    }
    
    model.compile(
        optimizer=keras.optimizers.Adam(1e-3),
        loss=losses,
        loss_weights=loss_weights,
        metrics=metrics
    )
    
    return model

def build_vit_multitask_model(num_csv_features):
    """Build Vision Transformer for multi-task soil fertility prediction."""
    
    # ViT parameters
    patch_size = 16
    num_patches = (IMG_SIZE // patch_size) ** 2
    projection_dim = 64
    num_heads = 4
    transformer_layers = 4
    
    # Image input and patching
    img_input = layers.Input(shape=(IMG_SIZE, IMG_SIZE, 3), name='image_input')
    patches = Patches(patch_size)(img_input)
    encoded_patches = PatchEncoder(num_patches, projection_dim)(patches)
    
    # Transformer blocks
    for _ in range(transformer_layers):
        # Layer normalization 1
        x1 = layers.LayerNormalization(epsilon=1e-6)(encoded_patches)
        
        # Multi-head attention
        attention_output = layers.MultiHeadAttention(
            num_heads=num_heads, key_dim=projection_dim, dropout=0.1
        )(x1, x1)
        
        # Skip connection 1
        x2 = layers.Add()([attention_output, encoded_patches])
        
        # Layer normalization 2
        x3 = layers.LayerNormalization(epsilon=1e-6)(x2)
        
        # MLP
        x3 = layers.Dense(projection_dim * 2, activation=tf.nn.gelu)(x3)
        x3 = layers.Dropout(0.1)(x3)
        x3 = layers.Dense(projection_dim, activation=tf.nn.gelu)(x3)
        x3 = layers.Dropout(0.1)(x3)
        
        # Skip connection 2
        encoded_patches = layers.Add()([x3, x2])
    
    # ViT representation
    representation = layers.LayerNormalization(epsilon=1e-6)(encoded_patches)
    representation = layers.GlobalAveragePooling1D()(representation)
    representation = layers.Dropout(0.2)(representation)
    
    # CSV input branch
    csv_input = layers.Input(shape=(num_csv_features,), name='csv_input')
    csv_features = layers.Dense(128, activation='relu')(csv_input)
    csv_features = layers.BatchNormalization()(csv_features)
    csv_features = layers.Dropout(0.3)(csv_features)
    
    # Combine ViT features with CSV features
    combined = layers.Concatenate()([representation, csv_features])
    combined = layers.Dense(256, activation='relu')(combined)
    combined = layers.BatchNormalization()(combined)
    combined = layers.Dropout(0.4)(combined)
    
    # Output heads (same as other models)
    fertility_reg = layers.Dense(128, activation='relu')(combined)
    fertility_reg_output = layers.Dense(1, activation='linear', name='fertility_reg')(fertility_reg)
    
    fertility_cls = layers.Dense(128, activation='relu')(combined)
    fertility_cls_output = layers.Dense(NUM_FERTILITY_CLASSES, activation='softmax', name='fertility_cls')(fertility_cls)
    
    land_use = layers.Dense(128, activation='relu')(combined)
    land_use_output = layers.Dense(10, activation='softmax', name='land_use')(land_use)
    
    model = keras.Model(inputs=[img_input, csv_input], 
                       outputs=[fertility_reg_output, fertility_cls_output, land_use_output])
    
    # Compile with same settings
    losses = {
        'fertility_reg': 'mse',
        'fertility_cls': 'sparse_categorical_crossentropy',
        'land_use': 'sparse_categorical_crossentropy'
    }
    
    loss_weights = {
        'fertility_reg': 0.4,
        'fertility_cls': 0.4,
        'land_use': 0.2
    }
    
    metrics = {
        'fertility_reg': ['mae', 'mse'],
        'fertility_cls': ['accuracy'],
        'land_use': ['accuracy']
    }
    
    model.compile(
        optimizer=keras.optimizers.Adam(1e-3),
        loss=losses,
        loss_weights=loss_weights,
        metrics=metrics
    )
    
    return model

# ViT Helper Layers (same as before)
class Patches(layers.Layer):
    def __init__(self, patch_size):
        super().__init__()
        self.patch_size = patch_size

    def call(self, images):
        batch_size = tf.shape(images)[0]
        patches = tf.image.extract_patches(
            images=images,
            sizes=[1, self.patch_size, self.patch_size, 1],
            strides=[1, self.patch_size, self.patch_size, 1],
            rates=[1, 1, 1, 1],
            padding="VALID",
        )
        patch_dims = patches.shape[-1]
        patches = tf.reshape(patches, [batch_size, -1, patch_dims])
        return patches

class PatchEncoder(layers.Layer):
    def __init__(self, num_patches, projection_dim):
        super().__init__()
        self.num_patches = num_patches
        self.projection = layers.Dense(units=projection_dim)
        self.position_embedding = layers.Embedding(
            input_dim=num_patches, output_dim=projection_dim
        )

    def call(self, patch):
        positions = tf.range(start=0, limit=self.num_patches, delta=1)
        encoded = self.projection(patch) + self.position_embedding(positions)
        return encoded

