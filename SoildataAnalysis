print("\n📥 Loading soil data...")

def load_and_clean_data(csv_path):
    """Load and clean soil data with robust error handling"""
    try:
        df = pd.read_csv(csv_path, low_memory=False)
        print(f"✅ Raw data loaded: {df.shape[0]:,} rows, {df.shape[1]} columns")
    except Exception as e:
        print(f"❌ Failed to load data: {e}")
        sys.exit(1)
    
    # Clean numeric columns (from your code)
    numeric_cols = ['OC', 'pH_H2O', 'P', 'K', 'N', 'EC', 'CaCO3', 
                   'OC (20-30 cm)', 'CaCO3 (20-30 cm)', 'Ox_Al', 'Ox_Fe']
    
    for col in numeric_cols:
        if col in df.columns:
            # Clean the column
            cleaned = df[col].astype(str).str.replace('< LOD', '', regex=False)
            cleaned = pd.to_numeric(cleaned, errors='coerce')
            if cleaned.notna().sum() > 0:
                df[col] = cleaned.fillna(cleaned.median())
            else:
                df[col] = cleaned.fillna(0.0)
    
    # Handle categorical data
    if 'Depth' in df.columns:
        df['Depth_code'] = pd.Categorical(df['Depth']).codes
    
    if 'LU1_Desc' in df.columns:
        df['land_use_code'] = pd.Categorical(df['LU1_Desc']).codes
    else:
        df['LU1_Desc'] = 'Unknown'
        df['land_use_code'] = 0
    
    return df

df_soil = load_and_clean_data(csv_file)

