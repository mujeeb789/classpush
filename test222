def load_and_preprocess_soil_data():
    """Load and preprocess soil data for multi-task learning."""
    if not os.path.exists(CLEAN_DATA_PATH):
        print(f"❌ Clean soil data not found at {CLEAN_DATA_PATH}")
        print("👉 Please run the exploration script first!")
        return None, None
    
    df = pd.read_csv(CLEAN_DATA_PATH)
    print(f"✅ Loaded {len(df)} soil samples")
    
    # Check and prepare data
    result = check_and_prepare_data(df)
    if result is None:
        return None, None
    
    df, available_params = result
    
    # Filter valid samples
    df['photo_exists'] = df['photo_path'].apply(lambda x: x is not None and os.path.exists(x) if pd.notna(x) else False)
    df = df[df['photo_exists']].copy()
    
    if len(df) == 0:
        print("❌ No valid samples with images found!")
        return None, None
    
    print(f"✅ {len(df)} samples with valid images")
    return df, available_params

def build_soil_dataset(df, csv_features, shuffle=True, augment=False):
    """Build tf.data.Dataset for multi-task soil fertility prediction."""
    
    # Encode targets
    fertility_encoder = LabelEncoder()
    land_use_encoder = LabelEncoder()
    
    df['fertility_encoded'] = fertility_encoder.fit_transform(df['Fertility_Class'])
    df['land_use_encoded'] = land_use_encoder.fit_transform(df['LU1_Desc'])
    
    # Calculate number of land use classes
    num_land_use_classes = len(df['LU1_Desc'].unique())
    
    # Scale CSV features
    scaler = StandardScaler()
    csv_data = scaler.fit_transform(df[csv_features].fillna(0).values)
    
    # Convert to tensors
    image_paths = tf.constant(df['photo_path'].values)
    csv_tensor = tf.constant(csv_data, dtype=tf.float32)
    fertility_scores = tf.constant(df['fertility_score_advanced'].values, dtype=tf.float32)
    fertility_classes = tf.constant(df['fertility_encoded'].values, dtype=tf.int32)
    land_use_classes = tf.constant(df['land_use_encoded'].values, dtype=tf.int32)
    
    def load_and_preprocess_image(path):
        """Load and preprocess a single image with robust error handling."""
        try:
            # Read the file
            img_data = tf.io.read_file(path)
            
            # Try to decode JPEG
            img = tf.image.decode_jpeg(img_data, channels=3)
            
            # Check if image is valid
            img_shape = tf.shape(img)
            is_valid = tf.reduce_all(img_shape > 0)
            
            # Use valid image or create blank one
            img = tf.cond(
                is_valid,
                lambda: img,
                lambda: tf.zeros([IMG_SIZE, IMG_SIZE, 3], dtype=tf.uint8)
            )
            
            # Resize and normalize
            img = tf.image.resize(img, [IMG_SIZE, IMG_SIZE])
            img = tf.cast(img, tf.float32) / 255.0
            
            return img
            
        except Exception:
            # Return blank image on any error
            return tf.zeros([IMG_SIZE, IMG_SIZE, 3], dtype=tf.float32) / 255.0
    
    def process_sample(i):
        """Process a single sample."""
        i = i.numpy()
        img = load_and_preprocess_image(image_paths[i])
        csv_feat = csv_tensor[i]
        fertility_score = fertility_scores[i]
        fertility_class = fertility_classes[i]
        land_use = land_use_classes[i]
        
        return img, csv_feat, fertility_score, fertility_class, land_use
    
    # Create dataset
    dataset = tf.data.Dataset.range(len(df))
    
    if shuffle:
        dataset = dataset.shuffle(len(df))
    
    # Use py_function with separate outputs
    dataset = dataset.map(
        lambda i: tf.py_function(
            func=process_sample,
            inp=[i],
            Tout=[tf.float32, tf.float32, tf.float32, tf.int32, tf.int32]
        ),
        num_parallel_calls=tf.data.AUTOTUNE
    )
    
    # Set shapes and structure into final format
    def structure_output(img, csv, reg, cls, lu):
        img.set_shape((IMG_SIZE, IMG_SIZE, 3))
        csv.set_shape((len(csv_features),))
        reg.set_shape(())
        cls.set_shape(())
        lu.set_shape(())
        
        # Structure into final format that model expects
        inputs = (img, csv)
        targets = {
            'fertility_reg': reg,
            'fertility_cls': cls, 
            'land_use': lu
        }
        return inputs, targets
    
    dataset = dataset.map(structure_output, num_parallel_calls=tf.data.AUTOTUNE)
    
    if augment:
        def augment_data(inputs, targets):
            img, csv = inputs
            # Apply augmentations only to images
            img = tf.image.random_flip_left_right(img)
            img = tf.image.random_flip_up_down(img)
            img = tf.image.random_brightness(img, 0.2)
            img = tf.clip_by_value(img, 0.0, 1.0)
            return (img, csv), targets
        
        dataset = dataset.map(augment_data, num_parallel_calls=tf.data.AUTOTUNE)
    
    dataset = dataset.batch(BATCH_SIZE).prefetch(tf.data.AUTOTUNE)
    return dataset, scaler, fertility_encoder, land_use_encoder, num_land_use_classes

