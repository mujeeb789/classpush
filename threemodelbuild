def test_model(model_name):
    print(f"\n🧪 Testing {model_name.upper()} for Soil Fertility Prediction...")
    
    model_path = os.path.join(MODELS_DIR, f"soil_model_{model_name}")
    if not os.path.exists(model_path):
        print(f"❌ Model not found at {model_path}")
        print("👉 Train the model first!")
        return
    
    # Load model and artifacts
    import joblib
    try:
        if model_name == "vit":
            # For ViT, we need to rebuild the model architecture
            csv_features = joblib.load(os.path.join(MODELS_DIR, f'csv_features_{model_name}.pkl'))
            model = build_vit_multitask_model(len(csv_features))
            model.load_weights(os.path.join(model_path, "variables", "variables"))
        else:
            model = keras.models.load_model(model_path)
        
        fertility_encoder = joblib.load(os.path.join(MODELS_DIR, f'fertility_encoder_{model_name}.pkl'))
        land_use_encoder = joblib.load(os.path.join(MODELS_DIR, f'land_use_encoder_{model_name}.pkl'))
        scaler = joblib.load(os.path.join(MODELS_DIR, f'feature_scaler_{model_name}.pkl'))
        csv_features = joblib.load(os.path.join(MODELS_DIR, f'csv_features_{model_name}.pkl'))
        
    except Exception as e:
        print(f"❌ Error loading model artifacts: {e}")
        return
    
    # Load test data
    df = load_and_preprocess_soil_data()
    if df is None:
        return
    
    # Use validation split for testing
    train_size = int(0.8 * len(df))
    df_test = df.iloc[train_size:]
    
    test_ds, _, _, _ = build_soil_dataset(df_test, csv_features, shuffle=False, augment=False)
    
    # Evaluate
    print("📊 Evaluating model on test set...")
    results = model.evaluate(test_ds, verbose=0)
    
    # Print results
    print("\n📈 Test Results:")
    print("-" * 50)
    print(f"Total Loss: {results[0]:.4f}")
    print(f"Fertility Regression MAE: {results[5]:.4f}")  # Adjust indices based on your metrics
    print(f"Fertility Classification Accuracy: {results[6]:.4f} ({results[6]*100:.2f}%)")
    print(f"Land Use Accuracy: {results[7]:.4f} ({results[7]*100:.2f}%)")
    
    # Make predictions on a sample
    print("\n🔍 Single Sample Prediction:")
    sample = df_test.sample(1).iloc[0]
    
    # Prepare inputs
    img = tf.io.read_file(sample['photo_path'])
    img = tf.image.decode_jpeg(img, channels=3)
    img = tf.image.resize(img, [IMG_SIZE, IMG_SIZE])
    img = tf.cast(img, tf.float32) / 255.0
    img = tf.expand_dims(img, 0)
    
    csv_data = scaler.transform([sample[csv_features].fillna(0).values])
    
    # Predict
    pred_reg, pred_cls, pred_land = model.predict([img, csv_data], verbose=0)
    
    # Display results
    true_fertility = sample['Fertility_Class']
    pred_fertility = fertility_encoder.inverse_transform([np.argmax(pred_cls[0])])[0]
    pred_score = pred_reg[0][0]
    true_score = sample['fertility_score_advanced']
    
    print(f"🌱 True Fertility: {true_fertility} (Score: {true_score:.2f})")
    print(f"🤖 Predicted Fertility: {pred_fertility} (Score: {pred_score:.2f})")
    print(f"📊 Confidence: {np.max(pred_cls[0]):.2%}")
    
    # Show image
    img_np = tf.keras.utils.array_to_img(img[0])
    plt.figure(figsize=(8, 6))
    plt.imshow(img_np)
    plt.title(f"True: {true_fertility} (Score: {true_score:.1f})\n"
              f"Pred: {pred_fertility} (Score: {pred_score:.1f})\n"
              f"Confidence: {np.max(pred_cls[0]):.1%}")
    plt.axis('off')
    plt.tight_layout()
    plt.savefig(os.path.join(PROJECT_ROOT, f"soil_prediction_{model_name}.png"), dpi=150, bbox_inches='tight')
    plt.show()

