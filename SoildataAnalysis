def find_image_path(pointid, nut0, download_dir, suffixes):
    """Find image path using your directory structure"""
    if not pointid or str(pointid) == 'nan':
        return None
        
    # Your directory search patterns
    search_patterns = []
    for suffix in suffixes:
        search_patterns.extend([
            os.path.join(download_dir, nut0, str(pointid)[:3], str(pointid)[3:6], f"{pointid}{suffix}.jpg"),
            os.path.join(download_dir, nut0, str(pointid)[:4], str(pointid)[4:6], f"{pointid}{suffix}.jpg"),
            os.path.join(download_dir, nut0, str(pointid), f"{pointid}{suffix}.jpg"),
            os.path.join(download_dir, nut0, f"{pointid}{suffix}.jpg"),
            os.path.join(download_dir, f"{pointid}{suffix}.jpg")
        ])
    
    for pattern in search_patterns:
        if os.path.exists(pattern):
            return pattern
    return None

