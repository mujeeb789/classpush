def calculate_fertility_score(df, weights=None):
    """Calculate fertility score if missing from the data"""
    if weights is None:
        weights = SCORE_WEIGHTS
        
    # Ensure required columns exist
    required_cols = ['pH_H2O', 'OC', 'N', 'P', 'K', 'land_use_code']
    for col in required_cols:
        if col not in df.columns:
            df[col] = 0.0 if col != 'land_use_code' else 0
            
    # Normalize pH
    ph_range = weights['ph']['max'] - weights['ph']['min']
    df['ph_norm'] = np.clip(
        (df['pH_H2O'] - weights['ph']['min']) / max(ph_range, 0.1), 0, 1
    )
    
    # Normalize Organic Carbon
    df['oc_norm'] = np.clip(df['OC'] / max(weights['oc']['max'], 1.0), 0, 1)
    
    # Nutrient balance
    df['nutrient_balance'] = (
        np.log1p(df['N'].fillna(0)) + 
        np.log1p(df['P'].fillna(0)) + 
        np.log1p(df['K'].fillna(0))
    )
    
    # Normalize nutrient balance
    if df['nutrient_balance'].nunique() > 1:
        nut_min = df['nutrient_balance'].min()
        nut_max = df['nutrient_balance'].max()
        df['nutrient_balance_norm'] = (df['nutrient_balance'] - nut_min) / max((nut_max - nut_min), 0.1)
    else:
        df['nutrient_balance_norm'] = 0.5
        
    # Normalize land use
    if df['land_use_code'].nunique() > 1:
        land_use_max = df['land_use_code'].max()
        land_use_norm = df['land_use_code'] / max(land_use_max, 1)
    else:
        land_use_norm = 0.5
        
    # Combined score
    df['fertility_score_advanced'] = (
        weights['ph']['weight'] * df['ph_norm'] +
        weights['oc']['weight'] * df['oc_norm'] +
        weights['nutrients']['weight'] * df['nutrient_balance_norm'] +
        weights['land_use']['weight'] * land_use_norm
    ) * 100.0
    
    return df

def check_and_prepare_data(df):
    """Check for required columns and prepare data for training"""
    print("🔍 Checking data structure...")
    
    # Check required columns
    required_columns = {
        'photo_path': 'Image paths',
        'Fertility_Class': 'Fertility classification', 
        'LU1_Desc': 'Land use descriptions'
    }
    
    missing_columns = [col for col in required_columns.keys() if col not in df.columns]
    if missing_columns:
        print(f"❌ Missing required columns: {missing_columns}")
        return None
    
    # Check if fertility_score_advanced exists, if not calculate it
    if 'fertility_score_advanced' not in df.columns:
        print("📊 Calculating fertility scores...")
        df = calculate_fertility_score(df)
    
    # Check for soil parameter columns
    soil_params = ['OC', 'pH_H2O', 'P', 'K', 'N', 'EC', 'CaCO3']
    available_params = [param for param in soil_params if param in df.columns]
    print(f"✅ Available soil parameters: {available_params}")
    
    if len(available_params) == 0:
        print("❌ No soil parameters found for training!")
        return None
    
    return df, available_params

