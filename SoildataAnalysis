print("\n🌿 Classifying soil fertility...")

def classify_soil_fertility(df):
    """Classify soil fertility based on OC and pH levels"""
    # Safeguard for missing columns
    if 'OC' not in df.columns:
        df['OC'] = 10.0
    if 'pH_H2O' not in df.columns:
        df['pH_H2O'] = 6.5
        
    # Organic Carbon classification
    conditions_oc = [
        (df['OC'] < 10),
        (df['OC'] >= 10) & (df['OC'] <= 20),
        (df['OC'] > 20)
    ]
    df['OC_Class'] = np.select(conditions_oc, ['Low', 'Moderate', 'High'], default='Moderate')
    
    # pH classification  
    conditions_ph = [
        (df['pH_H2O'] < 5.5),
        (df['pH_H2O'] >= 5.5) & (df['pH_H2O'] <= 6.8),
        (df['pH_H2O'] > 6.8)
    ]
    df['pH_Class'] = np.select(conditions_ph, ['Acidic', 'Neutral', 'Alkaline'], default='Neutral')
    
    # Combined fertility classification
    conditions_fertility = [
        (df['OC'] < 10) | (df['pH_H2O'] < 5.5),
        ((df['OC'] >= 10) & (df['OC'] <= 20)) & (df['pH_H2O'] >= 5.5) & (df['pH_H2O'] <= 6.8),
        (df['OC'] > 20) | (df['pH_H2O'] > 6.8)
    ]
    df['Fertility_Class'] = np.select(conditions_fertility, ['Low', 'Moderate', 'High'], default='Moderate')
    
    return df

